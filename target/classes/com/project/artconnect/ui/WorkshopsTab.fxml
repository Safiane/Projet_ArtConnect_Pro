<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="Workshops" style="-fx-font-size: 14; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <Button fx:id="bookBtn" text="✔ Book Workshop" onAction="#handleBook" style="-fx-base: #FF9800; -fx-text-fill: white;" />
    </HBox>
    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn"      text="Title"        prefWidth="200" />
            <TableColumn fx:id="instructorColumn" text="Instructor"   prefWidth="130" />
            <TableColumn fx:id="dateColumn"       text="Date"         prefWidth="140" />
            <TableColumn fx:id="durationColumn"   text="Duration"     prefWidth="80"  />
            <TableColumn fx:id="priceColumn"      text="Price (€)"    prefWidth="80"  />
            <TableColumn fx:id="levelColumn"      text="Level"        prefWidth="90"  />
            <TableColumn fx:id="spotsColumn"      text="Spots left"   prefWidth="80"  />
        </columns>
    </TableView>
</VBox>
