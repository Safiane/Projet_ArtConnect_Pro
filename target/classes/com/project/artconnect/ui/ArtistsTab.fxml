<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtistController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artists..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="disciplineFilter" promptText="Filter by Discipline" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Reset"  onAction="#handleReset" />
        <Separator orientation="VERTICAL" />
        <Button fx:id="addBtn"    text="+ Add"   onAction="#handleAdd"    style="-fx-base: #4CAF50; -fx-text-fill: white;" />
        <Button fx:id="editBtn"   text="✎ Edit"  onAction="#handleEdit"   style="-fx-base: #2196F3; -fx-text-fill: white;" />
        <Button fx:id="deleteBtn" text="✕ Delete" onAction="#handleDelete" style="-fx-base: #f44336; -fx-text-fill: white;" />
    </HBox>
    <TableView fx:id="artistTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn"        text="Name"        prefWidth="160" />
            <TableColumn fx:id="cityColumn"        text="City"        prefWidth="110" />
            <TableColumn fx:id="emailColumn"       text="Email"       prefWidth="180" />
            <TableColumn fx:id="yearColumn"        text="Birth Year"  prefWidth="80"  />
            <TableColumn fx:id="disciplinesColumn" text="Disciplines" prefWidth="220" />
            <TableColumn fx:id="activeColumn"      text="Active"      prefWidth="60"  />
        </columns>
    </TableView>
</VBox>
